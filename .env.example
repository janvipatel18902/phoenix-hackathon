# Copy to .env (gitignored) and fill in. Never commit real values.

# --- MongoDB Atlas (required) ---
MONGODB_URI=
MONGODB_DB=phoenix

# --- Mock world (the code defaults this to http://localhost:8001) ---
MOCK_WORLD_URL=http://localhost:8001

# --- LLM, used only to diagnose API drift (optional: a built-in heuristic is the fallback) ---
# Groq is picked automatically when GROQ_API_KEY is set; or set LLM_PROVIDER=anthropic
# with LLM_API_KEY and LLM_MODEL.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# --- Embeddings for recovery memories (optional: a local hashed embedding is the fallback) ---
EMBEDDING_PROVIDER=voyageai
EMBEDDING_BASE_URL=https://ai.mongodb.com
EMBEDDING_MODEL=voyage-4-lite
EMBEDDING_API_KEY=
# 1024 for voyage-4-lite; 256 for the local fallback. Must match the vector index.
EMBEDDING_DIM=1024
MEMORY_MIN_SCORE=0.80

# --- Demo knobs ---
PHOENIX_TASK_DELAY_MS=150
# PHOENIX_CRASH_AT=after_response:262
# PHOENIX_DEMO_WRONG_FIRST=1
